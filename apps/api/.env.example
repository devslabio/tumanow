PORT=3345
JWT_SECRET=dev-insecure-tumanow-secret-change-in-production
DATABASE_URL=postgresql://tumanow:tumanow@127.0.0.1:5432/tumanow

# Comma-separated browser origins allowed to call this API (web app, admin UI, etc.)
# Required in production; defaults to the local dev web app if unset.
CORS_ORIGINS=http://127.0.0.1:3006,http://localhost:3006

# Messaging: log (console, default) | live (real providers) | off (silent)
# "live" without the provider vars below configured behaves like "log" for
# that channel — flipping this alone never breaks anything.
MESSAGING_MODE=log

# SMS via Africa's Talking (https://africastalking.com) — leave blank to keep SMS on log mode
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_SENDER_ID=

# Email via SendGrid (https://sendgrid.com) — leave blank to keep email on log mode
SENDGRID_API_KEY=
EMAIL_FROM=notifications@tumanow.rw

# Payments sandbox: auto-confirm after initiate (set false to require /confirm)
PAYMENTS_AUTO_CONFIRM=true
